{
  "name": "refined-threads",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "A collection of small, switchable features that make Threads web better, including a spam and bot filter.",
  "license": "MIT",
  "homepage": "https://github.com/hannoeru/refined-threads#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannoeru/refined-threads.git"
  },
  "bugs": "https://github.com/hannoeru/refined-threads/issues",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm compile && pnpm test && pnpm build && pnpm build:firefox",
    "postinstall": "wxt prepare",
    "icons": "node scripts/icons.mjs",
    "bench": "vitest run --config vitest.perf.config.ts",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix"
  },
  "dependencies": {
    "re2js": "2.10.0",
    "valibot": "1.5.0",
    "vue": "3.6.0-rc.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@wxt-dev/module-vue": "1.0.3",
    "changelogithub": "15.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-slop": "0.1.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "happy-dom": "21.0.4",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "wxt": "0.21.5"
  }
}
