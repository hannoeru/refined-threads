#!/usr/bin/env python3
"""Print the Chrome extension ID for an unpacked build directory (default: .output/chrome-mv3)."""
import hashlib, os, sys
path = os.path.realpath(sys.argv[1] if len(sys.argv) > 1 else '.output/chrome-mv3')
digest = hashlib.sha256(path.encode()).hexdigest()[:32]
print(''.join(chr(ord('a') + int(c, 16)) for c in digest))
